diff --git a/app/src/main/java/com/winlator/cmod/xenvironment/ImageFsInstaller.java b/app/src/main/java/com/winlator/cmod/xenvironment/ImageFsInstaller.java
index 633076e..d208a66 100644
--- a/app/src/main/java/com/winlator/cmod/xenvironment/ImageFsInstaller.java
+++ b/app/src/main/java/com/winlator/cmod/xenvironment/ImageFsInstaller.java
@@ -140,6 +140,47 @@ public abstract class ImageFsInstaller {
         });
     }
 
+    public static boolean needsInstall(Context context) {
+        ImageFs imageFs = ImageFs.find(context);
+        return !imageFs.isValid() || imageFs.getVersion() < LATEST_VERSION;
+    }
+
+    /** Installs the system image without any UI, for the game-pack launcher. Call from a worker thread. */
+    public static boolean installFromAssetsBlocking(Context context, com.winlator.cmod.core.Callback<Integer> onProgress) {
+        ImageFs imageFs = ImageFs.find(context);
+        File rootDir = imageFs.getRootDir();
+
+        androidx.preference.PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .remove("current_box64_version")
+                .remove("current_wowbox64_version")
+                .remove("current_fexcore_version")
+                .apply();
+
+        clearRootDir(rootDir);
+        final byte compressionRatio = 24;
+        final long contentLength = (long)(FileUtils.getSize(context, "imagefs.txz") * (100.0f / compressionRatio));
+        AtomicLong totalSizeRef = new AtomicLong();
+
+        boolean success = TarCompressorUtils.extract(TarCompressorUtils.Type.XZ, context, "imagefs.txz", rootDir, (file, size) -> {
+            if (size > 0 && onProgress != null) {
+                long totalSize = totalSizeRef.addAndGet(size);
+                onProgress.call(Math.min(100, (int)(((float)totalSize / contentLength) * 100)));
+            }
+            return file;
+        });
+
+        if (success) {
+            for (String version : context.getResources().getStringArray(R.array.wine_entries)) {
+                File outFile = new File(rootDir, "/opt/" + version);
+                outFile.mkdirs();
+                TarCompressorUtils.extract(TarCompressorUtils.Type.XZ, context, version + ".txz", outFile);
+            }
+            imageFs.createImgVersionFile(LATEST_VERSION);
+            resetContainerImgVersions(context);
+        }
+        return success;
+    }
+
     public static void installIfNeeded(final MainActivity activity) {
         ImageFs imageFs = ImageFs.find(activity);
         if (!imageFs.isValid() || imageFs.getVersion() < LATEST_VERSION) installFromAssets(activity);
