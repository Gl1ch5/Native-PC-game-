<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="#0DFFFFFF" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_checked="true">
        <shape><solid android:color="#33E10600" /><stroke android:width="2dp" android:color="@color/gamepack_accent" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="@color/gamepack_card" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="8dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="@color/gamepack_card" /><stroke android:width="1dp" android:color="@color/gamepack_card_stroke" /><corners android:radius="8dp" /></shape>
    </item>
</selector>
