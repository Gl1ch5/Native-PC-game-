<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#33FFFFFF" /><stroke android:width="1dp" android:color="#88FFFFFF" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#22FFFFFF" /><stroke android:width="2dp" android:color="#FFFFFF" /><corners android:radius="6dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#14FFFFFF" /><stroke android:width="1dp" android:color="#55FFFFFF" /><corners android:radius="6dp" /></shape>
    </item>
</selector>
