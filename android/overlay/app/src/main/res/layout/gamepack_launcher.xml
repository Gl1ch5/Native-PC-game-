<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gamepack_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/gamepack_background"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gamepack_scrim" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="36dp"
        android:maxWidth="520dp"
        android:orientation="vertical">

        <View
            android:layout_width="56dp"
            android:layout_height="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/gamepack_stripe" />

        <TextView
            android:id="@+id/GPTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gamepack_text"
            android:textSize="44sp"
            android:textStyle="bold|italic"
            android:letterSpacing="0.02"
            android:shadowColor="#AA000000"
            android:shadowRadius="12" />

        <TextView
            android:id="@+id/GPStatus"
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minLines="2"
            android:textColor="@color/gamepack_text_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="420dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/GPProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/gamepack_progress"
                android:indeterminateTint="@color/gamepack_accent"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/GPPercent"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/gamepack_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/GPPrimaryButton"
                style="@style/GamePackButton"
                android:layout_width="wrap_content"
                android:text="@string/gamepack_play" />

            <Button
                android:id="@+id/GPCancelButton"
                style="@style/GamePackButton.Secondary"
                android:layout_width="wrap_content"
                android:text="@string/gamepack_cancel"
                android:visibility="gone" />

            <Button
                android:id="@+id/GPSettingsButton"
                style="@style/GamePackButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/gamepack_settings" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/GPNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:maxWidth="360dp"
        android:gravity="end"
        android:textColor="#80FFFFFF"
        android:textSize="10sp" />
</FrameLayout>
