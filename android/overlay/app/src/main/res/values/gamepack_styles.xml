<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GamePackTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/gamepack_accent</item>
        <item name="colorPrimary">@color/gamepack_bg</item>
        <item name="colorPrimaryDark">@color/gamepack_bg</item>
        <item name="android:windowBackground">@color/gamepack_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColor">@color/gamepack_text</item>
    </style>

    <style name="GamePackDialog" parent="@style/Theme.AppCompat.Dialog">
        <item name="colorAccent">@color/gamepack_accent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
        <item name="android:textColor">@color/gamepack_text</item>
    </style>

    <style name="GamePackButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">200dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:textColor">@color/gamepack_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@drawable/gamepack_button_primary</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="GamePackButton.Secondary">
        <item name="android:minWidth">0dp</item>
        <item name="android:background">@drawable/gamepack_button_secondary</item>
    </style>

    <style name="GamePackOption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/gamepack_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:background">@drawable/gamepack_option</item>
    </style>

    <style name="GamePackSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/gamepack_text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
