# Winlator Cmod (MIT), Bionic branch: the base the launcher is built on.
UPSTREAM_REPO=https://github.com/coffincolors/winlator
UPSTREAM_COMMIT=49bfb90fce932107cf6a7c1af62f910e7a1a2bfd
UPSTREAM_GH=coffincolors/winlator
# Upstream's cpp/sdl2 gitlink points to a commit that exists nowhere public. evshim only needs
# SDL2 headers (it resolves SDL functions with dlsym), so prepare.sh builds a header-only stand-in.
SDL2_REPO=https://github.com/libsdl-org/SDL
SDL2_TAG=release-2.32.10
